generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id         String      @id @default(cuid())
  name       String
  phone      String      @unique
  password   String
  village    String
  district   String?
  state      String?
  role       String      @default("citizen")
  isBlocked  Boolean     @default(false)
  createdAt  DateTime    @default(now())
  complaints Complaint[]
}

model VillageNews {
  id        String   @id @default(cuid())
  title     String
  content   String
  category  String   @default("News") // "Work Progress", "Complaint Solution", "News"
  createdAt DateTime @default(now())
}

model Complaint {
  id          String   @id @default(cuid())
  title       String
  category    String
  description String
  status      String   @default("Pending")
  createdAt   DateTime @default(now())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
}

model Scheme {
  id                String   @id @default(cuid())
  title             String
  category          String
  description       String
  eligibility       String
  documentsRequired String[]
  status            String   @default("Active")
  deadline          DateTime
  createdAt         DateTime @default(now())
}

model Notice {
  id        String   @id @default(cuid())
  title     String
  content   String
  type      String
  date      DateTime
  createdAt DateTime @default(now())
}

model Event {
  id          String   @id @default(cuid())
  title       String
  description String
  location    String
  date        DateTime
  createdAt   DateTime @default(now())
}
